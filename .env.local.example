# --- football-data.org ---
# Free token from https://www.football-data.org/client/register
# Without it, the app runs in DEMO MODE with realistic sample data.
# In Vercel, add this as an ENCRYPTED env var (NOT prefixed with NEXT_PUBLIC_).
FOOTBALL_DATA_TOKEN=

# Optional: pin the edition if the default ever resolves to the wrong year.
# FOOTBALL_DATA_SEASON=2026

# Set to "true" ONLY after upgrading to a livescores plan (e.g. "Free w/ Livescores",
# €12/mo). It removes the "live data delayed" badge. No other change needed.
# FOOTBALL_DATA_LIVESCORES=false
